# Environment Configuration Template
# Copy to .env or ~/.env for workstation-specific environment variables

# Core Desktop Defaults
EDITOR=nvim
VISUAL=nvim
BROWSER=firefox
TERMINAL=alacritty

# Wayland / Graphics Environment
MOZ_ENABLE_WAYLAND=1
QT_QPA_PLATFORM=wayland;xcb
XDG_CURRENT_DESKTOP=sway

# AI Provider Keys (Leave actual keys out of version control)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
