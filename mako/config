# ─── General ─────────────────────────────────────────────
font=Iosevka Nerd Font 11
sort=-time
layer=overlay
anchor=top-right

width=300
height=110
margin=5
padding=10
icons=0
max-icon-size=64

border-size=2
border-radius=6

default-timeout=5000
ignore-timeout=1

# ─── Tokyo Night Colors ──────────────────────────────────
background-color=#1a1b26
text-color=#c0caf5
border-color=#7aa2f7

# ─── Urgency Rules ───────────────────────────────────────
[urgency=high]
border-color=#f7768e
default-timeout=0

# ─── Custom Rules ────────────────────────────────────────
[summary~="log-.*"]
border-color=#e0af68
