# Machine-specific Sway output configuration template
# Copy to ~/.config/sway/outputs or ~/.config/sway/config.d/outputs.local

# Default integrated laptop display
output eDP-1 {
    mode 1920x1080@60Hz
    scale 1.0
    pos 0 0
    transform normal
}

# External monitor example (HDMI)
# output HDMI-A-1 {
#     mode 1920x1080@60Hz
#     scale 1.0
#     pos 1920 0
#     transform normal
# }

# External DisplayPort monitor example
# output DP-1 {
#     mode 2560x1440@144Hz
#     scale 1.0
#     pos 1920 0
# }
