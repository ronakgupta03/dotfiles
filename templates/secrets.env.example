# Safe Secrets Template
# NEVER commit your actual keys, credentials, or tokens to version control.
# Copy this template to ~/.secrets.env or source within ~/.zshrc.local:
#
#   cp templates/secrets.env.example ~/.secrets.env
#   chmod 600 ~/.secrets.env
#
# Add 'source ~/.secrets.env' to your ~/.zshrc.local

# AI / LLM API Keys
export GEMINI_API_KEY=""
export OPENROUTER_API_KEY=""
export ANTHROPIC_API_KEY=""
export OPENAI_API_KEY=""

# Cloud / Hosting Tokens
# export AWS_ACCESS_KEY_ID=""
# export AWS_SECRET_ACCESS_KEY=""
# export GITHUB_TOKEN=""
